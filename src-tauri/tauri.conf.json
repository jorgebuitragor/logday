{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logday",
  "version": "1.0.0",
  "identifier": "com.jorgebuitrago.logday",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "decorations": true,
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jorge Buitrago",
    "copyright": "© 2026 Jorge Buitrago",
    "shortDescription": "Proyecto sin animo de lucro para colaboradores de la FCV",
    "longDescription": "Logday es una aplicación de escritorio para gestionar tareas, notas, horas extra y actividad diaria. Almacena todo localmente en archivos Markdown, con soporte para vista Kanban, calendario y exportación a PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
