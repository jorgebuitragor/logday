    "allow-open-in-system",
    "allow-open-url",
    "allow-write-clipboard",
    "allow-read-file-binary",
    "allow-write-file-binary",
    "allow-fetch-image-base64",
    "allow-git-run",
    "allow-sync-request",
    "allow-fetch-url-metadata",
    "allow-fs-pick-folder",
    "allow-fs-pick-files",
