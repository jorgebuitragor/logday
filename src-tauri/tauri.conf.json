{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logday",
  "version": "1.3.0",
  "identifier": "com.jorgebuitrago.logday",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "decorations": true,
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com",
        "media-src": "'self' data: blob: https:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5RDMyQzk5QzA4NDlBMjMKUldRam1vVEFtU3pUT1dHNDJCRGFWTjZXOTZPTzgvemwyTjN3NnZiN2pvU2w2a3R1b29wYmg5SVAK",
      "endpoints": [
        "https://github.com/jorgebuitragor/logday/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Jorge Buitrago",
    "copyright": "© 2026 Jorge Buitrago",
    "shortDescription": "Software libre de gestión personal — tareas, notas, horas extra y actividad diaria",
    "longDescription": "Logday es una aplicación de escritorio para gestionar tareas, notas, horas extra y actividad diaria. Almacena todo localmente en archivos Markdown, con soporte para vista Kanban, calendario y exportación a PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
